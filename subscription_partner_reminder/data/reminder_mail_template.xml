<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="subscription_partner_reminder_reminder_mail_template" model="mail.template">
            <field name="name">Subscription Reminder</field>
            <field name="model_id" ref="subscription_oca.model_sale_subscription"/>
            <field name="subject">Subscription Reminder for {{object.name}}</field>
            <field name="email_from">{{object.user_id.email}}</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="lang">{{object.partner_id.lang}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear
                        <t t-if="object.partner_id.name">
                            <t t-out="object.partner_id.name"/>
                        </t>
                        <t t-else="">
                            Customer
                        </t>
                    </p>

                    <p>This is a reminder that your subscription will expire soon.</p>

                    <p>Subscription details:</p>
                    <ul>
                        <li>Expiration Date:
                            <t t-if="object.date">
                                <t t-out="object.date"/>
                            </t>
                            <t t-else="">
                                Not specified
                            </t>
                        </li>
                        <li>Days Remaining:
                            <t t-if="object.date">
                                <t t-out="(object.date - datetime.date.today()).days"/>
                                <span> Days</span>
                            </t>
                        </li>
                    </ul>

                    <p>Please renew your subscription to avoid any interruption in service.</p>

                    <p>Best regards,
                        <br/>
                        <t t-if="user.company_id.name">
                            <t t-out="user.company_id.name"></t>
                        </t>
                        <t t-else="">
                            Your Company
                        </t>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
#. module: subscription_partner_reminder
#: model:mail.template,body_html:subscription_partner_reminder.subscription_partner_reminder_reminder_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Dear\n"
"                        <t t-if=\"object.partner_id.name\">\n"
"                            <t t-out=\"object.partner_id.name\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Customer\n"
"                        </t>\n"
"                    </p>\n"
"\n"
"                    <p>This is a reminder that your subscription will expire soon.</p>\n"
"\n"
"                    <p>Subscription details:</p>\n"
"                    <ul>\n"
"                        <li>Expiration Date:\n"
"                            <t t-if=\"object.date\">\n"
"                                <t t-out=\"object.date\"/>\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                Not specified\n"
"                            </t>\n"
"                        </li>\n"
"                        <li>Days Remaining:\n"
"                            <t t-if=\"object.date\">\n"
"                                <t t-out=\"(object.date - datetime.date.today()).days\"/>\n"
"                                <span> Days</span>\n"
"                            </t>\n"
"                        </li>\n"
"                    </ul>\n"
"\n"
"                    <p>Please renew your subscription to avoid any interruption in service.</p>\n"
"\n"
"                    <p>Best regards,\n"
"                        <br/>\n"
"                        <t t-if=\"user.company_id.name\">\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Your Company\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Cher(ère)\n"
"                        <t t-if=\"object.partner_id.name\">\n"
"                            <t t-out=\"object.partner_id.name\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Client(e)\n"
"                        </t>\n"
"                    </p>\n"
"\n"
"                    <p>Ceci est un rappel que votre abonnement arrivera bientôt à expiration.</p>\n"
"\n"
"                    <p>Détails de l'abonnement :</p>\n"
"                    <ul>\n"
"                        <li>Date d'expiration :\n"
"                            <t t-if=\"object.date\">\n"
"                                <t t-out=\"object.date\"/>\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                Non spécifiée\n"
"                            </t>\n"
"                        </li>\n"
"                        <li>Jours restants :\n"
"                            <t t-if=\"object.date\">\n"
"                                <t t-out=\"(object.date - datetime.date.today()).days\"/>\n"
"                                <span> jours</span>\n"
"                            </t>\n"
"                        </li>\n"
"                    </ul>\n"
"\n"
"                    <p>Merci de renouveler votre abonnement pour éviter toute interruption de service.</p>\n"
"\n"
"                    <p>Cordialement,\n"
"                        <br/>\n"
"                        <t t-if=\"user.company_id.name\">\n"
"                            <t t-out=\"user.company_id.name\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Votre entreprise\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "


